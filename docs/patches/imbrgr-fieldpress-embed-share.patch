+++ b/src/lib/studio-embed.ts
@@ -0,0 +1,23 @@
+/** FieldPress embeds imbrgr studio with `?embed=1`. */
+
+export function isStudioEmbedParam(raw: string | null | undefined): boolean {
+  if (!raw) return false;
+  const v = raw.trim().toLowerCase();
+  return v === "1" || v === "true" || v === "yes";
+}
+
+/** Origins allowed to frame /studio when embed=1 (CSP frame-ancestors). */
+export const FIELDPRESS_FRAME_ANCESTORS = [
+  "'self'",
+  "https://fieldpress.studio",
+  "https://www.fieldpress.studio",
+  "https://*.vercel.app",
+  "http://localhost:5173",
+  "http://localhost:3000",
+  "http://127.0.0.1:5173",
+  "http://127.0.0.1:3000",
+] as const;
+
+export function studioEmbedCspFrameAncestors(): string {
+  return `frame-ancestors ${FIELDPRESS_FRAME_ANCESTORS.join(" ")}`;
+}
diff --git a/src/middleware.ts b/src/middleware.ts
new file mode 100644
index 0000000..ceaadec
--- /dev/null
+++ b/src/middleware.ts
@@ -0,0 +1,22 @@
+import { NextResponse, type NextRequest } from "next/server";
+import { isStudioEmbedParam, studioEmbedCspFrameAncestors } from "@/lib/studio-embed";
+
+/**
+ * Allow FieldPress to iframe /studio when `embed=1`.
+ * Clears legacy DENY framing so the Visual tray embed works.
+ */
+export function middleware(req: NextRequest) {
+  const res = NextResponse.next();
+  const path = req.nextUrl.pathname;
+  if (!path.startsWith("/studio")) return res;
+
+  if (isStudioEmbedParam(req.nextUrl.searchParams.get("embed"))) {
+    res.headers.set("Content-Security-Policy", studioEmbedCspFrameAncestors());
+    res.headers.delete("X-Frame-Options");
+  }
+  return res;
+}
+
+export const config = {
+  matcher: ["/studio", "/studio/:path*"],
+};
