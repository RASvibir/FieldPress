# Copy to .env and fill in values. Never commit .env.

# Application
NODE_ENV=development
APP_URL=http://localhost:5173
PUBLIC_ORIGIN=https://fieldpress.studio
API_URL=http://localhost:3000
PORT=3000

# Database (Neon pooled for the API, unpooled for drizzle-kit)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require
# Local Docker alternative:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/heliumdb

# Authentication
AUTH_SECRET=
AUTH_ISSUER=https://fieldpress.studio
AUTH_AUDIENCE=https://fieldpress.studio
RESEND_API_KEY=
MAIL_FROM=FieldPress <noreply@fieldpress.studio>

# Object storage (do not expose these via VITE_*)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=fieldpress-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Media processing
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_MAX_UPLOAD_BYTES=21474836480

# Background jobs
QUEUE_URL=
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_API_KEY=

# Observability
SENTRY_DSN=
LOG_LEVEL=info

# Desktop Vite
BASE_PATH=/

# Gemini — used by the AI Producer (never commit the real key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional: 1 = extra Gemini Google Search briefing before drafts (uses more quota)
GEMINI_TREND_SEARCH=
