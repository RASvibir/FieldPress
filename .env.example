# Copy to .env and fill in values. Never commit .env.

# Application
NODE_ENV=development
APP_URL=http://localhost:5173
PUBLIC_ORIGIN=https://fieldpress.studio
API_URL=http://localhost:3000
PORT=3000

# Database (Neon pooled for the API, unpooled for drizzle-kit)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/FieldPress?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/FieldPress?sslmode=require
# Local Docker alternative:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/heliumdb

# Authentication
AUTH_SECRET=
AUTH_ISSUER=https://fieldpress.studio
AUTH_AUDIENCE=https://fieldpress.studio
RESEND_API_KEY=
MAIL_FROM=FieldPress <noreply@fieldpress.studio>

# Object storage (do not expose these via VITE_*)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=fieldpress-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Media processing
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_MAX_UPLOAD_BYTES=21474836480

# Background jobs
QUEUE_URL=
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_API_KEY=

# Observability
SENTRY_DSN=
LOG_LEVEL=info

# Desktop Vite
BASE_PATH=/

# Gemini — used by the AI Producer (never commit the real key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional: 1 = extra Gemini Google Search briefing before drafts (uses more quota)
GEMINI_TREND_SEARCH=

# Local Ollama (the live Worker cannot see 127.0.0.1 — use the desktop proxy, a Cloudflare Tunnel URL, or wrangler --local)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Optional Ollama Cloud: https://ollama.com
OLLAMA_API_KEY=
# Optional Groq free-tier llama
GROQ_API_KEY=

# Wire feed cron (required in production, or /api/feeds?action=sync returns 401).
# Vercel sends it as "Authorization: Bearer $CRON_SECRET" on cron calls. Generate with: openssl rand -hex 32
# Set it as a Sensitive env var in Vercel; never commit a real value.
CRON_SECRET=

# Super-admin signup (the setup key is required to create the super-admin account)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_SETUP_KEY=

# Outbound mail (Zoho SMTP). USER and FROM have defaults in api/_lib/mailer.mjs.
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=
ZOHO_SMTP_FROM=

# Pressyo AI assistant
PRESSYO_DAILY_LIMIT=40
# OLLAMA_URL takes precedence over OLLAMA_HOST (see api/pressyo.mjs)
OLLAMA_URL=
GROQ_MODEL=llama-3.3-70b-versatile

# Client (Vite) settings; both default to the production URLs in src/config/site.ts
VITE_FIELDPRESS_PUBLIC_URL=https://fieldpress.studio
VITE_IMBRGR_URL=https://imbrgr.website
# Opt-in: also trust imbrgr-*.vercel.app preview origins for the embed (leave unset in production)
# VITE_IMBRGR_TRUST_PREVIEWS=1
